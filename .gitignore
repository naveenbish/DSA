# Ignore node_modules
node_modules/

# Ignore build files
dist/
out/
build/

# Ignore TypeScript files output
*.js
*.js.map
*.d.ts

# Ignore environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ignore logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Ignore IDE/editor settings
.vscode/
.idea/
.DS_Store

# Ignore package manager lock files (optional)
package-lock.json
yarn.lock
pnpm-lock.yaml
